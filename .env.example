# Copy this file to .env and fill in the values. Never commit .env.
MONGO_ROOT_USERNAME=inkwell
MONGO_ROOT_PASSWORD=
# Used by `go run` on your machine. (Compose will set its own in step 8.)
MONGODB_URI="mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@localhost:27017/?directConnection=true&authSource=admin"